{
  "name": "obsidian-git-scm",
  "version": "0.1.0",
  "description": "Git source control for Obsidian: stage, commit, push/pull/fetch, branches, commit graph, conflict resolution",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/core.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.4.0"
  }
}
